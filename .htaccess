RewriteEngine On

# ---- WebP content negotiation ----
# When the browser accepts WebP and a .webp twin of the requested .jpg/.jpeg
# exists next to it, serve the WebP transparently (same URL). Browsers that
# don't send Accept: image/webp keep getting the original JPG. Only 44 of the
# JPGs have a smaller .webp twin; the rest simply fall through to the JPG.
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME} (?i)(.+)\.(jpe?g)$
RewriteCond %1.webp -f
RewriteRule (?i)^(.+)\.(jpe?g)$ $1.webp [T=image/webp,L]

<IfModule mod_headers.c>
    # Caches must key on Accept so a WebP isn't served to a non-WebP client.
    <FilesMatch "\.(jpe?g)$">
        Header append Vary Accept
    </FilesMatch>
</IfModule>

RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /en/ [R=302,L]

RewriteCond %{REQUEST_URI} !\.(css|js|jpg|jpeg|png|webp|svg|gif|mp4|woff2?|ico)$
RewriteCond %{REQUEST_URI} !^/(en|it|assets|config|includes|lang|database)/
RewriteCond %{REQUEST_URI} !\.php$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ $1.php [L]

# ---- Cache policy ----
# Static assets are always requested with a ?v=<mtime> query string (see
# asset() in includes/functions.php), so it's safe to cache them
# aggressively — the URL itself changes the moment the file's content
# does, which busts any cache automatically without a manual version bump.
# PHP-rendered pages (the actual HTML) must never be cached: every visit
# has to hit the server and see whatever was deployed most recently.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|gif|mp4|woff2?|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
