RewriteEngine On

RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /en/ [R=302,L]

RewriteCond %{REQUEST_URI} !\.(css|js|jpg|jpeg|png|webp|svg|gif|mp4|woff2?|ico)$
RewriteCond %{REQUEST_URI} !^/(en|it|assets|config|includes|lang|database)/
RewriteCond %{REQUEST_URI} !\.php$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ $1.php [L]
